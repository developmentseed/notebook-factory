# ---- Core -----------------------------------------------------------------
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_BASE_URL=http://localhost:8000          # used in notification links
SITE_NAME=Montandon Notebooks

# ---- Database (PostGIS required) -----------------------------------------
DATABASE_URL=postgis://postgres:postgres@localhost:5432/notebook_factory
# macOS Homebrew paths are auto-detected; set explicitly elsewhere if needed:
# GDAL_LIBRARY_PATH=/usr/lib/libgdal.so
# GEOS_LIBRARY_PATH=/usr/lib/libgeos_c.so

# ---- Task queue -----------------------------------------------------------
# Leave empty to run notebooks in-process (no Redis / worker needed).
CELERY_BROKER_URL=
# CELERY_BROKER_URL=redis://localhost:6379/0
MONTANDON_POLL_INTERVAL_SECONDS=600
# In-process mode only: how many notebooks run at once
NOTEBOOK_EAGER_WORKERS=2
# Runs without progress for this many hours are marked failed by the cleanup task
NOTEBOOK_STALE_RUN_HOURS=6

# ---- Published output storage --------------------------------------------
# local | s3 | azure
PUBLISHED_STORAGE_BACKEND=local
PUBLISHED_ROOT=./data/published
PUBLISHED_URL=/published/
# Optional CDN / public base for published files (overrides the backend URL)
# PUBLISHED_PUBLIC_BASE_URL=https://cdn.example.org/notebooks

# S3 / MinIO
# S3_BUCKET=notebooks
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=eu-west-1
# S3_ENDPOINT_URL=http://localhost:9000      # MinIO / other S3-compatible
# S3_ADDRESSING_STYLE=path                   # for MinIO
# S3_CUSTOM_DOMAIN=notebooks.example.org

# Azure Blob. With no key or connection string, the app signs in with DefaultAzureCredential:
# the pod's workload identity on AKS, or `az login` locally.
# AZURE_ACCOUNT_NAME=
# AZURE_ACCOUNT_KEY=
# AZURE_CONNECTION_STRING=
# AZURE_CONTAINER=notebooks
# AZURE_CUSTOM_DOMAIN=

# ---- Notebook execution & rendering --------------------------------------
NOTEBOOK_TEMPLATES_DIR=./notebook_templates
NOTEBOOK_WORK_DIR=./data/work
NOTEBOOK_KEEP_WORKDIRS=true
NOTEBOOK_CELL_TIMEOUT=1200
# mystmd >= 1.10 is required (widgets). `npm i -g mystmd`, or use npx:
MYST_COMMAND=myst
# MYST_COMMAND=npx -y mystmd@1.10.1
MYST_TEMPLATE=book-theme
MYST_STRIP_THEBE=false
MYST_HIDE_CODE=true

# ---- Montandon ------------------------------------------------------------
MONTANDON_STAC_URL=https://montandon-eoapi-stage.ifrc.org/stac
MONTANDON_API_TOKEN=
MONTANDON_WRITEBACK_ENABLED=false
MONTANDON_POLL_LOOKBACK_DAYS=7

# ---- Email ----------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=notebooks@example.org
