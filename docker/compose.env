DEBUG=true
SECRET_KEY=compose-dev-secret
ALLOWED_HOSTS=*
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_URL=postgis://postgres:postgres@db:5432/notebook_factory
CELERY_BROKER_URL=redis://redis:6379/0
# Published notebooks go to MinIO; the browser fetches them from localhost:9000.
PUBLISHED_STORAGE_BACKEND=s3
S3_BUCKET=notebooks
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_ENDPOINT_URL=http://minio:9000
S3_ADDRESSING_STYLE=path
PUBLISHED_PUBLIC_BASE_URL=http://localhost:9000/notebooks
MYST_COMMAND=myst
NOTEBOOK_KEEP_WORKDIRS=false
# MONTANDON_API_TOKEN=
# MONTANDON_WRITEBACK_ENABLED=false
